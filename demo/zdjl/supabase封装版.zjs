{"type":"运行多个动作","scriptSet":[{"type":"设置变量","vars":[{"name":"username","value":{"varType":"string","syncValueOnChange":true,"showInput":true,"showInputLabel":"用户名","rememberInputValue":true}},{"name":"password","value":{"varType":"string","showAsPassword":true,"showInput":true,"showInputLabel":"密码"}}],"dialogTitle":"注册","dialogOKText":"确定","dialogCancelText":"取消","dialogCancelAction":{"type":"控制执行","controlRunType":"stop"}},{"type":"运行JS代码","jsCode":"const email = username + '@zdjl.com'\r\nconst supabase = zdjl.getVar(\"supabase\")\r\n\r\ntry {\r\n  const data = await supabase.auth.signUp({\r\n    email,\r\n    password\r\n  })\r\n  console.log('SignUp successful:', data)\r\n  console.log(\r\n    'Session:',\r\n    supabase.auth.getSession()\r\n  )\r\n  zdjl.setVar(\"password\", \"\")\r\n} catch (e) {\r\n  console.log(\"ERROR =\", e)\r\n  console.log(\"STATUS =\", e.status)\r\n  if(e.body) {\r\n    console.log(\"body=\", JSON.stringify(e.body))\r\n    console.log(\"MESSAGE =\", JSON.stringify(e.body.msg))\r\n    zdjl.toast(JSON.stringify(e.body.msg))\r\n  } else {\r\n    zdjl.toast(e)\r\n  }\r\n  zdjl.setVar(\"password\", \"\")\r\n}","desc":"注册demo代码"},{"type":"运行JS代码","jsCode":"const supabase = zdjl.getVar(\"supabase\")\r\n\r\nawait supabase.functions.invoke(\"init-profile\", {\r\n    nickname: username\r\n})","desc":"初始化profiles创建代码","delay":""}],"desc":"注册demo","disabled":true}
{"type":"运行多个动作","scriptSet":[{"type":"设置变量","vars":[{"name":"username","value":{"varType":"string","showInput":true,"showInputLabel":"用户名","rememberInputValue":true}},{"name":"password","value":{"varType":"string","showAsPassword":true,"showInput":true,"showInputLabel":"密码"}}],"dialogTitle":"注册","dialogOKText":"确定","dialogCancelText":"取消","dialogCancelAction":{"type":"控制执行","controlRunType":"stop"}},{"type":"运行JS代码","jsCode":"const email = username + '@zdjl.com'\r\nconst supabase = zdjl.getVar(\"supabase\")\r\n\r\ntry {\r\n  const result = await supabase.auth.signIn({\r\n    email,\r\n    password\r\n  })\r\n  console.log(\"LOGIN RESULT =\", result)\r\n  console.log(\r\n    \"SESSION AFTER LOGIN =\",\r\n    supabase.auth.getSession()\r\n  )\r\n  console.log(\r\n    \"ACCESS TOKEN =\",\r\n    supabase.auth.getAccessToken()\r\n  )\r\n  console.log(\r\n    \"REFRESH TOKEN =\",\r\n    supabase.auth.getRefreshToken()\r\n  )\r\n  zdjl.setVar(\"password\", \"\")\r\n} catch (e) {\r\n  console.log(\"ERROR =\", e)\r\n  console.log(\"STATUS =\", e.status)\r\n  if(e.body) {\r\n    console.log(\"body=\", JSON.stringify(e.body))\r\n    console.log(\"MESSAGE =\", JSON.stringify(e.body.msg))\r\n    zdjl.toast(JSON.stringify(e.body.msg))\r\n  } else {\r\n    zdjl.toast(e)\r\n  }\r\n  zdjl.setVar(\"password\", \"\")\r\n}"}],"desc":"登录demo","disabled":true}
{"type":"运行JS代码","jsCode":"const supabase = zdjl.getVar(\"supabase\")\r\nconst session = supabase.auth.getSession()\r\n\r\nif (!session) {\r\n  console.log(\"未登录\")\r\n} else {\r\n  console.log(session)\r\n}","desc":"查看用户会话demo","disabled":true}
{"type":"运行多个动作","scriptSet":[{"type":"运行JS代码","desc":"将个人信息初始化为环境变量","jsCode":"const supabase = zdjl.getVar(\"supabase\")\r\n\r\nconst session = supabase.auth.getSession()\r\n\r\nif (!session) {\r\n    zdjl.setVar(\"isLogin\", false)\r\n    console.log(\"未登录用户\")\r\n} else {\r\n    const profile = JSON.parse(\r\n        await supabase.db.single(\r\n            \"profiles\",\r\n            {\r\n                eq: {\r\n                    id: session.user.id\r\n                }\r\n            }\r\n        )\r\n    )\r\n\r\n    zdjl.setVar(\"isLogin\", true)\r\n    zdjl.setVar(\"email\", session.user.email)\r\n    zdjl.setVar(\"userId\", session.user.id)\r\n    zdjl.setVar(\"nickname\", profile.nickname)\r\n    zdjl.setVar(\"avatar\", profile.avatar || \"\")\r\n    zdjl.setVar(\"signature\", profile.signature || \"\")\r\n    zdjl.setVar(\"role\", profile.role)\r\n    zdjl.setVar(\"exp\", profile.exp)\r\n    zdjl.setVar(\"lastCheckinDate\", profile.last_checkin_date || null)\r\n\r\n    zdjl.setStorage(\"profile\", JSON.stringify(profile))\r\n\r\n    console.log(\"isLogin:\", zdjl.getVar(\"isLogin\"))\r\n    console.log(\"email:\", zdjl.getVar(\"email\"))\r\n    console.log(\"userId:\", zdjl.getVar(\"userId\"))\r\n    console.log(\"nickname:\", zdjl.getVar(\"nickname\"))\r\n    console.log(\"avatar:\", zdjl.getVar(\"avatar\"))\r\n    console.log(\"signature:\", zdjl.getVar(\"signature\"))\r\n    console.log(\"role:\", zdjl.getVar(\"role\"))\r\n    console.log(\"exp:\", zdjl.getVar(\"exp\"))\r\n    console.log(\"profile:\", zdjl.getStorage(\"profile\"))\r\n    console.log(\"lastCheckinDate:\", zdjl.getVar(\"lastCheckinDate\"))\r\n\r\n    const today = new Date().toISOString().slice(0, 10)\r\n    const hasCheckedIn = profile.last_checkin_date === today\r\nconsole.log(today)\r\nzdjl.setVar(\"hasCheckedIn\", hasCheckedIn)\r\nconsole.log(\"今天是否已签到:\", hasCheckedIn)\r\n}\r\n"},{"type":"设置变量","vars":[{"name":"userId","value":{"varType":"ui_text","showInput":true,"__vars":{"textContent":{"varType":"expression","valueExp":"zdjl.getVar(\"userId\")"}},"showInputLabel":"用户ID"}},{"name":"username","value":{"varType":"ui_text","showInput":true,"__vars":{"textContent":{"varType":"expression","valueExp":"zdjl.getVar(\"email\").split(\"@\")[0]"}},"showInputLabel":"用户名"}},{"name":"nickname","value":{"varType":"string","showInput":true,"__vars":{"value":{"varType":"expression","valueExp":"zdjl.getVar(\"nickname\")"}},"showInputLabel":"昵称","syncValueOnChange":true}},{"name":"头像预览","value":{"varType":"ui_text","showInput":true,"__vars":{"textContent":{"varType":"expression","valueExp":"'#MD\\n<img src=\\\"'+zdjl.getVar(\"avatar\")+'\\\" alt=\\\"头像\\\" width=\\\"100\\\" height=\\\"100\\\" />'"}}}},{"name":"avatar","value":{"varType":"string","showInput":true,"__vars":{"value":{"varType":"expression","valueExp":"zdjl.getVar(\"avatar\")"}},"showInputLabel":"头像URL","syncValueOnChange":true,"mustInput":false}},{"name":"signature","value":{"varType":"string","showInput":true,"__vars":{"value":{"varType":"expression","valueExp":"zdjl.getVar(\"signature\")"}},"showInputLabel":"个性签名","syncValueOnChange":true,"mustInput":false}},{"name":"role","value":{"varType":"ui_text","showInput":true,"__vars":{"textContent":{"varType":"expression","valueExp":"zdjl.getVar(\"role\") == \"admin\" ? \"管理员\" :\r\nzdjl.getVar(\"role\") == \"user\" ? \"普通用户\" : zdjl.getVar(\"role\")"}},"showInputLabel":"角色"}},{"name":"exp","value":{"varType":"ui_text","showInput":true,"__vars":{"textContent":{"varType":"expression","valueExp":"zdjl.getVar(\"exp\")"}},"showInputLabel":"经验"}},{"name":"lastCheckinDate","value":{"varType":"ui_text","showInput":true,"__vars":{"textContent":{"varType":"expression","valueExp":"zdjl.getVar(\"lastCheckinDate\")"}},"syncValueOnChange":true,"showInputLabel":"上次签到时间"}},{"name":"签到","value":{"varType":"ui_button","showInput":true,"closeDialogOnAction":false,"varDesc":"可签到","buttonText":"签到","__vars":{"showInputHiddenView":{"varType":"expression","valueExp":"zdjl.getVar(\"hasCheckedIn\")"}},"action":{"type":"运行JS代码","jsCode":"const supabase = zdjl.getVar(\"supabase\")\r\n\r\nconst result =\r\n    await supabase.functions.invoke(\r\n        \"daily-checkin\"\r\n    );\r\n\r\nif (result.ok) {\r\n  zdjl.setVar(\"exp\", result.exp)\r\n  zdjl.setVar(\"lastCheckinDate\", result.lastCheckinDate)\r\n  const today = new Date().toISOString().slice(0, 10)\r\n  const hasCheckedIn = result.last_checkin_date === today\r\n  zdjl.setVar(\"hasCheckedIn\", hasCheckedIn)\r\n}\r\nzdjl.toast(result.message);"}}},{"name":"已签到","value":{"varType":"ui_button","showInput":true,"closeDialogOnAction":false,"varDesc":"已签到","buttonText":"已签到","__vars":{"showInputHiddenView":{"varType":"expression","valueExp":"!zdjl.getVar(\"hasCheckedIn\")"}},"buttonStyle":"button"}}],"dialogOKText":"更新","dialogCancelText":"取消","dialogCancelAction":{"type":"控制执行","controlRunType":"stop"},"__vars":{"dialogTitle":{"varType":"expression","valueExp":"\"用户仪表盘(\" + (!!zdjl.getVar(\"isLogin\") ? zdjl.getVar(\"userId\") : \"未登录\") + \")\""}}},{"type":"运行JS代码","desc":"更新个人信息","jsCode":"const supabase = zdjl.getVar(\"supabase\")\r\n\r\n\r\nconst result = await supabase.functions.invoke(\r\n  \"update-profile\",\r\n  {\r\n      nickname,\r\n      avatar,\r\n      signature\r\n  }\r\n)\r\n\r\nif (result.ok) {\r\n  zdjl.toast(\"个人资料更新成功\");\r\n} else {\r\n  zdjl.toast(result.error);\r\n}\r\n"}],"desc":"用户控制台demo","disabled":true}
{"type":"运行多个动作","desc":"用户更改密码demo","scriptSet":[{"type":"设置变量","dialogTitle":"更改密码（仅限已登录用户）","vars":[{"name":"currentPassword","value":{"varType":"string","showAsPassword":true,"showInput":true,"showInputLabel":"原密码","varDesc":"若没有设置密码或未启用更新时要求提供当前密码时不需要填","mustInput":false}},{"name":"password","value":{"varType":"string","showAsPassword":true,"showInput":true,"stringItems":[],"showInputLabel":"新密码"}}],"dialogCancelAction":{"type":"控制执行","controlRunType":"stop"}},{"type":"运行JS代码","desc":"修改密码","jsCode":"const supabase = zdjl.getVar(\"supabase\")\r\n\r\ntry {\r\n  console.log(password)\r\n  console.log(currentPassword)\r\n    const result = await supabase.auth.updateUser({\r\n        password,\r\n        currentPassword,\r\n    })\r\n\r\n    console.log(result)\r\n    zdjl.toast(\"修改密码成功\")\r\n} catch (e) {\r\n  console.log(\"ERROR =\", e)\r\n  console.log(\"STATUS =\", e.status)\r\n  if(e.body) {\r\n    console.log(\"body=\", JSON.stringify(e.body))\r\n    console.log(\"MESSAGE =\", JSON.stringify(e.body.msg))\r\n    const errorMessages = {\r\n      current_password_invalid: \"当前密码错误\",\r\n      current_password_required: \"请输入当前密码\",\r\n      same_password: \"新密码不能与旧密码相同\",\r\n      weak_password: \"密码强度不足\",\r\n      reauthentication_needed: \"需要重新验证身份\",\r\n      email_exists: \"邮箱已被使用\",\r\n      phone_exists: \"手机号已被使用\"\r\n    }\r\n\r\n    const code = e.body?.error_code\r\n\r\n    zdjl.toast(\"更改密码失败，\" + \r\n      errorMessages[code] || code || \"操作失败\"\r\n    )\r\n  } else {\r\n    zdjl.toast(e)\r\n  }\r\n  zdjl.setVar(\"password\", \"\")\r\n  zdjl.setVar(\"currentPassword\", \"\")\r\n}"}],"disabled":true}
{"type":"运行多个动作","scriptSet":[{"type":"系统提示","promptType":"alert","promptTitle":"登出demo","actions":[{"name":"默认","script":{"type":"运行JS代码","jsCode":"const supabase = zdjl.getVar(\"supabase\")\r\nawait supabase.auth.signOut()"}},{"name":"global","script":{"type":"运行JS代码","jsCode":"const supabase = zdjl.getVar(\"supabase\")\r\nawait supabase.auth.signOut({ scope: 'global' })"}},{"name":"local","script":{"type":"运行JS代码","jsCode":"const supabase = zdjl.getVar(\"supabase\")\r\nawait supabase.auth.signOut({ scope: 'local' })"}},{"name":"others","script":{"type":"运行JS代码","jsCode":"const supabase = zdjl.getVar(\"supabase\")\r\nawait supabase.auth.signOut({ scope: 'others' })"}}],"promptText":"请选择登出方式\nglobal（默认）当所有对用户活跃的会话终止时。\nlocal这只会终止当前会话，但保持其他设备或浏览器的会话活跃。\nothers终止用户除当前会话外的所有会话。"}],"desc":"登出demo","disabled":true}
{"type":"运行多个动作","desc":"管理员查询用户列表demo","scriptSet":[{"type":"运行JS代码","jsCode":"const supabase = zdjl.getVar(\"supabase\")\r\n\r\nasync function loadUsers() {\r\n  try {\r\n    const result = await supabase.functions.invoke(\"admin-list-users\", {\r\n      method: \"POST\",\r\n      body: {} // 如果你的函数不需要参数\r\n    })\r\n\r\n    console.log(\"users =\", result.users)\r\n\r\n    // 写入环境变量\r\n    zdjl.setVar(\"user_list\", result.users)\r\n\r\n    zdjl.toast(\"用户列表加载成功\")\r\n  } catch (e) {\r\n    console.log(\"ERROR =\", e)\r\n\r\n    const code = e.body?.error_code || e.body?.code\r\n    if (code === \"403\" || e.status === 403) {\r\n      zdjl.toast(\"没有权限\")\r\n    } else {\r\n      zdjl.toast(code || \"加载用户失败\")\r\n    }\r\n  }\r\n}\r\n\r\nloadUsers()","desc":"获取用户列表"},{"type":"运行JS代码","desc":"构造markdown","jsCode":"zdjl.setVar(\"action_handler\", function(action) {\r\n  const [type, id] = action.split(\":\")\r\n\r\n  const users = zdjl.getVar(\"user_list\") || []\r\n\r\n  if (type === \"copy\") {\r\n    const u = users.find(x => x.id === id)\r\n    zdjl.setClipboard(u?.id)\r\n    zdjl.toast(\"已复制\")\r\n  }\r\n\r\n  if (type === \"edit\") {\r\n    zdjl.setVar(\"editing_user_id\", id)\r\n    zdjl.toast(\"进入编辑\" + id)\r\n    zdjl.runAction({\r\n      \"type\": \"控制执行\",\r\n      \"jumpToPosition\": \":admin-edit-user\",\r\n      \"controlRunType\": \"jumpTo\"\r\n    })\r\n  }\r\n})\r\n\r\nconst users = zdjl.getVar(\"user_list\") || []\r\n\r\nlet md = \"#MD\\n\\n#### 用户列表\\n\\n\"\r\n\r\nmd += \"| 用户 | 角色 | 操作 |\\n\"\r\nmd += \"|------|------|------|\\n\"\r\n\r\nfor (const u of users) {\r\n  md += `| ${u.nickname} | ${u.role} | `\r\n  md += `[复制ID](javascript:action_handler('copy:${u.id}')) `\r\n  md += `[编辑](javascript:action_handler('edit:${u.id}')) `\r\n  md += `|\\n`\r\n}\r\n\r\nzdjl.setVar(\"markdown\", md)"},{"type":"系统提示","promptType":"alert","__vars":{"promptText":{"varType":"expression","valueExp":"zdjl.getVar(\"markdown\")"}}},{"type":"运行多个动作","scriptSet":[{"type":"运行JS代码","desc":"将目标用户信息初始化为环境变量","jsCode":"const editingUserId =\r\n    zdjl.getVar(\"editing_user_id\")\r\n\r\nconst users =\r\n    zdjl.getVar(\"user_list\") || []\r\n\r\nconst profile =\r\n    users.find(\r\n        u => u.id === editingUserId\r\n    )\r\n\r\nif (!profile) {\r\n    zdjl.toast(\"用户不存在\")\r\n    return\r\n}\r\n\r\nzdjl.setVar(\"userId\", profile.id)\r\n\r\nzdjl.setVar(\"nickname\",\r\n    profile.nickname || \"\")\r\n\r\nzdjl.setVar(\"avatar\",\r\n    profile.avatar || \"\")\r\n\r\nzdjl.setVar(\"signature\",\r\n    profile.signature || \"\")\r\n\r\nzdjl.setVar(\"role\",\r\n    profile.role || \"user\")\r\n\r\nzdjl.setVar(\"exp\",\r\n    profile.exp || 0)\r\n\r\nzdjl.setStorage(\r\n    \"editing_profile\",\r\n    JSON.stringify(profile)\r\n)\r\n\r\nconsole.log(\r\n    \"editing_user_id\",\r\n    profile.id\r\n)\r\n\r\nconsole.log(\r\n    \"nickname\",\r\n    profile.nickname\r\n)\r\n\r\nconsole.log(\r\n    \"avatar\",\r\n    profile.avatar\r\n)\r\n\r\nconsole.log(\r\n    \"signature\",\r\n    profile.signature\r\n)\r\n\r\nconsole.log(\r\n    \"role\",\r\n    profile.role\r\n)\r\n\r\nconsole.log(\r\n    \"exp\",\r\n    profile.exp\r\n)"},{"type":"设置变量","vars":[{"name":"userId","value":{"varType":"ui_text","showInput":true,"__vars":{"textContent":{"varType":"expression","valueExp":"zdjl.getVar(\"userId\")"}},"showInputLabel":"用户ID"}},{"name":"nickname","value":{"varType":"string","showInput":true,"__vars":{"value":{"varType":"expression","valueExp":"zdjl.getVar(\"nickname\")"}},"showInputLabel":"昵称","syncValueOnChange":true}},{"name":"头像预览","value":{"varType":"ui_text","showInput":true,"__vars":{"textContent":{"varType":"expression","valueExp":"'#MD\\n<img src=\\\"'+zdjl.getVar(\"avatar\")+'\\\" alt=\\\"头像\\\" width=\\\"100\\\" height=\\\"100\\\" />'"}}}},{"name":"avatar","value":{"varType":"string","showInput":true,"__vars":{"value":{"varType":"expression","valueExp":"zdjl.getVar(\"avatar\")"}},"showInputLabel":"头像URL","syncValueOnChange":true,"mustInput":false}},{"name":"signature","value":{"varType":"string","showInput":true,"__vars":{"value":{"varType":"expression","valueExp":"zdjl.getVar(\"signature\")"}},"showInputLabel":"个性签名","syncValueOnChange":true,"mustInput":false}},{"name":"role","value":{"varType":"string","showAsPassword":false,"showInput":true,"stringItems":["user","admin"],"__vars":{"value":{"varType":"expression","valueExp":"zdjl.getVar(\"role\")"}},"value":"zdjl.getVar(\"role\") == \"admin\" ? \"管理员\" :\nzdjl.getVar(\"role\") == \"user\" ? \"普通用户\" : "}},{"name":"exp","value":{"varType":"number","__vars":{"number":{"varType":"expression","valueExp":"zdjl.getVar(\"exp\")"}},"showInput":true}}],"dialogOKText":"更新","dialogCancelText":"取消","dialogCancelAction":{"type":"控制执行","controlRunType":"stop"},"__vars":{"dialogTitle":{"varType":"expression","valueExp":"\"编辑用户(\" +  zdjl.getVar(\"editing_user_id\") + \")\""}},"desc":"编辑页面"},{"type":"运行JS代码","jsCode":"const supabase = zdjl.getVar(\"supabase\")\r\n\r\nasync function saveUser() {\r\n\r\n  try {\r\n\r\n    const result = await supabase.functions.invoke(\r\n      \"admin-update-user\",\r\n      {\r\n        targetId: zdjl.getVar(\"editing_user_id\"),\r\n        nickname,\r\n        avatar,\r\n        signature,\r\n        role,\r\n        exp: Number(exp)\r\n      }\r\n    )\r\n\r\n    console.log(\"update result =\", result)\r\n\r\n    if (result.ok) {\r\n\r\n      zdjl.toast(\"用户更新成功\")\r\n\r\n      // 更新本地缓存列表\r\n      const users =\r\n        zdjl.getVar(\"user_list\") || []\r\n\r\n      const index =\r\n        users.findIndex(\r\n          x => x.id === userId\r\n        )\r\n\r\n      if (index >= 0) {\r\n        users[index] = result.user\r\n      }\r\n\r\n      zdjl.setVar(\r\n        \"user_list\",\r\n        users\r\n      )\r\n\r\n    } else {\r\n\r\n      zdjl.toast(\r\n        result.error || \"更新失败\"\r\n      )\r\n\r\n    }\r\n\r\n  } catch (e) {\r\n    console.log(\"ERROR =\", e)\r\n    const code = e.body?.error_code || e.body?.code\r\n    if (code === \"403\" || e.status === 403) {\r\n      zdjl.toast(\"没有权限\")\r\n    } else {\r\n      zdjl.toast(\r\n        e.body?.error ||\r\n        e.message ||\r\n        \"更新失败\"\r\n      )\r\n    }\r\n  }\r\n}\r\n\r\nsaveUser()","desc":"保存编辑"}],"desc":"管理员编辑用户demo","jumpId":"admin-edit-user"}],"limitRunCount":3,"disabled":true}